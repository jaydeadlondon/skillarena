APP_NAME=SkillArena
APP_VERSION=1.0.0
APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-production-secret
APP_BASE_URL=https://your-domain.example
DATABASE_URL=postgresql+asyncpg://user:password@postgres-host:5432/skillarena
STEAM_API_KEY=replace-with-steam-web-api-key
STEAM_REALM=https://your-domain.example
STEAM_RETURN_URL=https://your-domain.example/auth/steam/callback
STEAM_MOCK_LOGIN=false
ADMIN_STEAM_IDS=7656119xxxxxxxxxx
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=1209600

LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_API_KEY=replace-with-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_DAILY_LIMIT_PER_USER=20
LLM_COOLDOWN_SECONDS=8
LLM_MAX_CUSTOM_PROMPT_CHARS=700
LLM_TIMEOUT_SECONDS=30
PVP_CREATE_COOLDOWN_SECONDS=20
PVP_MAX_WAITING_BATTLES_PER_USER=3

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_PREMIUM_DAYS_1M=30
TELEGRAM_PREMIUM_DAYS_3M=90
TELEGRAM_PREMIUM_DAYS_6M=180
TELEGRAM_PREMIUM_DAYS_12M=365
TELEGRAM_STARS_PRICE_1M=99
TELEGRAM_STARS_PRICE_3M=299
TELEGRAM_STARS_PRICE_6M=419
TELEGRAM_STARS_PRICE_12M=600

TRUSTED_HOSTS=your-domain.example,www.your-domain.example
